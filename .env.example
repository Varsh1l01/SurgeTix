# SurgeTix local development settings.
#
#   cp .env.example .env
#
# Then replace every "change-me" value. .env is git-ignored. Never commit it.
# Docker Compose reads this file for the containers, and each service binary
# reads it at start-up (variables already set in your shell take precedence).

# --- Shared ---------------------------------------------------------------
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# --- PostgreSQL (one database + role per owning service, ADR-008) ----------
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-admin
IDENTITY_DB_PASSWORD=change-me-identity
CATALOG_DB_PASSWORD=change-me-catalog
BOOKING_DB_PASSWORD=change-me-booking
CHECKOUT_DB_PASSWORD=change-me-checkout

# Each service connects only to its own database with its own role.
# Keep the passwords below identical to the *_DB_PASSWORD values above.
IDENTITY_DATABASE_URL=postgres://identity_svc:change-me-identity@localhost:15432/identity_db?sslmode=disable
CATALOG_DATABASE_URL=postgres://catalog_svc:change-me-catalog@localhost:15432/catalog_db?sslmode=disable
BOOKING_DATABASE_URL=postgres://booking_svc:change-me-booking@localhost:15432/booking_db?sslmode=disable
CHECKOUT_DATABASE_URL=postgres://checkout_svc:change-me-checkout@localhost:15432/checkout_db?sslmode=disable

# --- Redis ----------------------------------------------------------------
REDIS_PORT=16379
REDIS_ADDR=localhost:16379
REDIS_PASSWORD=change-me-redis

# --- Kafka (KRaft, single broker) ------------------------------------------
KAFKA_PORT=29092
KAFKA_BROKERS=localhost:29092
# Not a secret: a base64 UUID identifying the local KRaft cluster. To use a new one:
#   docker run --rm apache/kafka:4.4.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=C1fqC-bsRk2t8ThakhFpyA

# --- Service listen addresses (health endpoints in Phase 1) ---------------
GATEWAY_HTTP_ADDR=:18080
IDENTITY_HTTP_ADDR=:18081
CATALOG_HTTP_ADDR=:18082
WAITINGROOM_HTTP_ADDR=:18083
BOOKING_HTTP_ADDR=:18084
CHECKOUT_HTTP_ADDR=:18085
NOTIFIER_HTTP_ADDR=:18086

# --- Phase 2 UNSAFE NAIVE BASELINE (ADR-034) --------------------------------
# The baseline deliberately oversells. It runs only when BOTH keys are turned:
#   1. binaries built with:  go build -tags unsafe_baseline ./cmd/booking ./cmd/gateway
#   2. this flag set to true (a normal build refuses to start if it is true)
# Keep false except for benchmarks. See loadtest/README.md.
SURGETIX_ENABLE_UNSAFE_BASELINE=false
# Booking base URL the Gateway forwards the baseline route to (internal HTTP, AMB-40).
GATEWAY_BOOKING_URL=http://localhost:18084
